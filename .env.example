# Copy to .env.dev and fill in. .env.dev is gitignored.

# Files written into the bind-mounted ./data (rendered tiles) get this ownership.
# Set to your own `id -u` / `id -g`.
UID=1000
GID=1000

# --- Host ports (dev) ---
FRONT_PORT=9020
API_PORT=9021
CH_HTTP_PORT=9023
CH_NATIVE_PORT=9024

# --- Frontend ---
FRONTEND_TARGET=development
FRONTEND_COMMAND=npm run dev
NUXT_PUBLIC_API_BASE_URL=http://localhost:9021
# Server-side (SSR) only — inside the compose network the API is reachable by
# service name, not by the browser-facing localhost URL above.
API_INTERNAL_BASE_URL=http://api:4000
NUXT_PUBLIC_MAPBOX_TOKEN=
NUXT_PUBLIC_VERSION=0.1

# --- Data paths (inside containers; ./data is mounted at /opt/data) ---
OISST_NC_DIR=/opt/data/sst
OISST_IMAGE_DIR=/opt/data/images

# --- ClickHouse ---
CH_HOST=db-ch
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=enso
CLICKHOUSE_PASSWORD=

# Point api/process at a remote ClickHouse instead of the local db-ch service
CH_USE_REMOTE=false
CH_REMOTE_URL=
CH_REMOTE_USER=
CH_REMOTE_PASSWORD=

# --- CoralTemp climatology (366 daily files, mounted read-only) ---
CRW_CLIM_DIR=/opt/data/climatology

# --- Usage analytics (PostHog Cloud) ---
# Both sides are a silent no-op with the key unset, so leaving these blank is a
# supported configuration and not a broken one. NOTE: env vars are baked in at
# container creation — after editing these run
#   docker compose ... up -d --force-recreate front api
# A plain `restart` reuses the old environment.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Prefect (dev: behind the `prefect` profile) ---
# docker compose -f docker-compose.dev.yml --env-file .env.dev \
#   --profile prefect up -d prefect scheduler
PREFECT_PORT=9025
PREFECT_PUBLIC_URL=http://localhost:9025
# user:password. Never blank — Prefect reads "" as a password, not as no auth.
PREFECT_AUTH_STRING=admin:admin
# Dev opens paused and never prunes: a dev `run` without keep_nc deletes
# ./data/sst and ./data/MHW back to the open week.
RUN_CRON=30 16 * * *
RUN_SCHEDULE_PAUSED=true
RUN_KEEP_NC=true
