# Copy to .env.preview and fill in. Used only by docker-compose.preview.yml:
#   docker compose -f docker-compose.preview.yml --env-file .env.preview up -d --build

# The host port the front end is published on.
FRONT_PORT=9020

# Required. If the token is restricted to certain URLs, add this host's URL to
# it, or the map renders blank.
NUXT_PUBLIC_MAPBOX_TOKEN=

# Optional: shown in the About dialog.
# NUXT_PUBLIC_VERSION=preview

# Optional: the API the page reads. Defaults to production.
# NUXT_PUBLIC_API_BASE_URL=https://mhw-api.cioospacific.ca
